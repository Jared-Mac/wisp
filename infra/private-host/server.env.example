# Fresh server only. Install root:wisp 0640 at /etc/wisp/server.env.
# No client recovery files, friend.env, or WISP_E2EE_KEY may be copied here.
WISP_SERVER_ADDR=127.0.0.1:8787
WISP_PUBLIC_URL=https://wisp.example.com
WISP_DATABASE_URL=sqlite:///var/lib/wisp/wisp.sqlite3
WISP_REQUIRE_CHAT_E2EE=true
WISP_ALLOW_DEV_SESSIONS=false
WISP_LIVEKIT_URL=wss://wisp.example.com:8443
WISP_LIVEKIT_API_KEY=REPLACE_WITH_FRESH_SERVICE_KEY_ID
WISP_LIVEKIT_API_SECRET=replace-with-a-fresh-random-service-secret
# Only for first administrator enrollment; remove after it succeeds.
WISP_BOOTSTRAP_TOKEN=replace-with-a-different-fresh-random-bootstrap-secret
RUST_LOG=wisp_server=warn,tower_http=warn
