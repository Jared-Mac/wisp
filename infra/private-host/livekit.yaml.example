# Tailnet-only signaling and RTC; do not enable recording/egress or debug endpoints.
port: 7880
bind_addresses:
  - "127.0.0.1"
  - "REPLACE_WITH_TAILSCALE_IPV4"
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: false
  node_ip: "REPLACE_WITH_TAILSCALE_IPV4"
  interfaces:
    includes:
      - tailscale0
keys:
  REPLACE_WITH_FRESH_SERVICE_KEY_ID: replace-with-the-same-livekit-service-secret-as-server-env
logging:
  level: warn
