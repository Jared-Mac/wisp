[Unit]
Description=Wisp private LiveKit media relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wisp-media
Group=wisp-media
ExecStart=/usr/local/bin/livekit-server --config /etc/wisp-media/livekit.yaml
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
