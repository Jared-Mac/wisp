[Desktop Entry]
Type=Application
Name=Wisp
GenericName=Voice hangouts
Comment=Voice-first presence and hangouts for close friends
Exec="@WISP_LAUNCH_EXEC@" %u
MimeType=x-scheme-handler/wisp-invite;
Icon=dev.wisp
Terminal=false
Categories=Network;Chat;
Keywords=voice;friends;hangout;
StartupWMClass=dev.wisp
