# Copy to ~/.config/wisp/server.env, set mode 0600, and replace every example.
WISP_SERVER_ADDR=100.64.0.1:8787
WISP_DATABASE_URL=sqlite:///home/you/.local/share/wisp/server/wisp.sqlite3
WISP_LIVEKIT_URL=ws://your-host.tailnet.ts.net:7880
WISP_LIVEKIT_API_KEY=wisp-private-alpha
WISP_LIVEKIT_API_SECRET=replace-with-openssl-rand-hex-32
WISP_BOOTSTRAP_TOKEN=replace-with-openssl-rand-hex-32
WISP_ALLOW_DEV_SESSIONS=false
